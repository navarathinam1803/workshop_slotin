# Workshop SlotIn backend — example env (copy to .env and set as needed)
# Optional: not required for core workshop, booking, waitlist, or refund flows.

# Path to workshops JSON file (default: backend/workshops.json)
# WORKSHOPS_JSON=./workshops.json

# Optional: API keys or URLs for future integrations (e.g. notification service)
# NOTIFICATION_API_KEY=
# NOTIFICATION_URL=
